 ],
 "captions": [
  {
   "t": "Encontré una cartera con cinco mil euros en el suelo… y era de la persona que más me odiaba.",
   "s": 0.05,
   "e": 4.65
  },
  {
   "t": "Mi profesor de matemáticas. El que me había suspendido tres veces seguidas.",
   "s": 5.2,
   "e": 9.79
  },
  {
   "t": "Con ese dinero podía comprarme todo lo que siempre había querido.",
   "s": 10.09,
   "e": 13.12
  },
  {
   "t": "Pero fui a su casa. Y llamé a la puerta.",
   "s": 13.42,
   "e": 16.18
  },
  {
   "t": "Me abrió llorando. Ese dinero era para la operación de su hija.",
   "s": 16.48,
   "e": 20.57
  },
  {
   "t": "No dijo nada. Solo me abrazó.",
   "s": 21.12,
   "e": 23.5
  },
  {
   "t": "Al día siguiente, en clase, me devolvió el examen. Un cero… tachado.",
   "s": 23.8,
   "e": 28.84
  },
  {
   "t": "«Este no lo has suspendido», me dijo. «Lo has aprobado con matrícula».",
   "s": 29.39,
   "e": 33.78
  },
  {
   "t": "¿Tú la habrías devuelto? Comenta.",
   "s": 34.08,
   "e": 36.42
  }
 ],
