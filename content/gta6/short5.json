 "captions": [
  {
   "t": "¿No sabes cómo ir al Tacón en GTA 6? Mira.",
   "s": 0.05,
   "e": 3.13
  },
  {
   "t": "Está en Vice City, y en el gameplay oficial se llega de noche, por un callejón lleno de neones.",
   "s": 3.21,
   "e": 7.3
  },
  {
   "t": "Esta es la entrada. Fíjate en los carteles: solo mayores de veintiuno, control de DNI… y nada de armas.",
   "s": 7.38,
   "e": 13.45
  },
  {
   "t": "Saludas al portero… y para dentro.",
   "s": 13.53,
   "e": 15.32
  },
  {
   "t": "Y así es el Tacón por dentro: luces de neón, música a tope y el local lleno de gente.",
   "s": 15.4,
   "e": 19.51
  },
  {
   "t": "Y lo mejor: en pantalla te sale la opción de lanzar billetes.",
   "s": 19.59,
   "e": 22.34
  },
  {
   "t": "¿Vas a ir al Tacón nada más empezar el juego? Comenta.",
   "s": 22.42,
   "e": 25.48
  }
 ],
