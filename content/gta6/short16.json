 "captions": [
  {
   "t": "Pon esto a pantalla completa. Estas son las vistas más bonitas de GTA 6.",
   "s": 0.05,
   "e": 4.8
  },
  {
   "t": "Saltar en paracaídas sobre Vice City, con toda la costa debajo.",
   "s": 4.88,
   "e": 8.16
  },
  {
   "t": "El paracaídas se abre… y tienes la ciudad entera a tus pies.",
   "s": 8.24,
   "e": 11.32
  },
  {
   "t": "La bahía al atardecer, llena de yates.",
   "s": 11.4,
   "e": 13.59
  },
  {
   "t": "Y bajo el agua de las Leonida Keys… arrecifes y peces de verdad.",
   "s": 13.67,
   "e": 16.89
  },
  {
   "t": "Por la noche, el horizonte de la ciudad parece una postal.",
   "s": 16.97,
   "e": 19.81
  },
  {
   "t": "Y conducir por la costa, con el sol de frente, no tiene precio.",
   "s": 19.89,
   "e": 23.29
  },
  {
   "t": "¿Cuál es tu vista favorita? ¡Comenta!",
   "s": 23.37,
   "e": 25.97
  }
 ],
