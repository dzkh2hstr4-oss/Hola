 "captions": [
  {
   "t": "Lucía, la protagonista de GTA 6,",
   "s": 0.05,
   "e": 2.11
  },
  {
   "t": "acaba de salir de la cárcel.",
   "s": 2.06,
   "e": 3.38
  },
  {
   "t": "Y no, no fue por buena conducta.",
   "s": 3.45,
   "e": 5.11
  },
  {
   "t": "Su padre le enseñó a pelear nada más aprender a andar.",
   "s": 5.18,
   "e": 7.58
  },
  {
   "t": "Peleando por su familia acabó en la Penitenciaría de Leonida…",
   "s": 7.65,
   "e": 10.24
  },
  {
   "t": "y salió por pura suerte.",
   "s": 10.31,
   "e": 11.54
  },
  {
   "t": "Ahora quiere la buena vida que su madre soñaba desde sus días en Liberty City.",
   "s": 11.61,
   "e": 14.74
  },
  {
   "t": "Y Jason creció entre estafadores.",
   "s": 14.81,
   "e": 16.38
  },
  {
   "t": "Después del ejército, acabó en los Cayos trabajando para traficantes.",
   "s": 16.45,
   "e": 19.79
  },
  {
   "t": "Conocer a Lucía puede ser lo mejor…",
   "s": 19.86,
   "e": 21.52
  },
  {
   "t": "o lo peor que le ha pasado.",
   "s": 21.59,
   "e": 22.78
  },
  {
   "t": "¿Tú con quién vas, Jason o Lucía?",
   "s": 22.85,
   "e": 24.55
  }
 ],
